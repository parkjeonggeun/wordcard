# =============================================================================
# Wordcard PWA - Environment Template
# 복사:
#   cp .env.example .env.local
#
# 주의:
# - .env.local 은 절대 커밋하지 않는다.
# - NEXT_PUBLIC_* 값은 클라이언트 번들에 포함된다 (공개 정보만 넣을 것).
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=낱말카드
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# ElevenLabs TTS (영어 발음 고품질 음성)
# 발급: https://elevenlabs.io → Profile → API Key (무료 가입)
# 용도: 영어 단어 TTS (미설정 시 Web Speech API로 자동 fallback)
# 무료 티어: 10,000자/월 (30단어 앱은 충분)
# 기본 음성: Aria (9BWtsMINqrJLrRacOk9x) — 밝고 또렷한 미국 여성 영어
# -----------------------------------------------------------------------------
ELEVENLABS_API_KEY=your-elevenlabs-api-key
# ELEVENLABS_VOICE_ID=9BWtsMINqrJLrRacOk9x  # 기본값, 변경 가능

# -----------------------------------------------------------------------------
# Google Analytics (선택)
# 발급: https://analytics.google.com
# 용도: 사용 통계 수집 (선택 사항)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# -----------------------------------------------------------------------------
# Supabase (선택 - 학습 기록 저장 기능 추가 시)
# 발급: https://supabase.com → 프로젝트 Settings > API
# 용도: 카드 학습 기록 저장, 진행률 동기화
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
